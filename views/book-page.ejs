<%- include ('partials/head') %>

    <body>
        <%- include ('partials/nav') %>
        <br>
            <h1>Book Details</h1>
            <br>
            <main>
                <p class="book-title"><strong>Title:</strong>
                    <%= book.title %>
                </p>
                <p class="book-detail"><strong>Author:</strong>
                    <%= book.author %>
                </p>
                <p class="book-detail"><strong>Genre:</strong>
                    <%= book.genre %>
                </p>
                <p class="book-detail"><strong>Pages:</strong>
                    <%= book.pages %>
                    <!-- The first form should be sending a DELETE request -->
                <form action="/books/<%= book.id %>?_method=DELETE" method="POST">
                    <input type="hidden" name="id" value="<%= book.id %>">
                    <button type="submit">Delete Book</button>
                </form>
<!-- The second form should be sending a GET request so that it loads the edit page for that specific book -->
                <form action="/books/<%= book.id %>/edit" method="GET">
                    <input type="hidden" name="id" value="<%= book.id %>">
                    <button type="submit">Edit Book</button>
                </form>

                <a href="/books">Back to Book List</a>
            </main>

    </body>